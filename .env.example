# GitHub section (src/lib/github.ts)
# Fine-grained personal access token with "Public repositories (read-only)" and
# no other permissions. Used server-side only, at build time and daily ISR
# revalidation, for the GraphQL contribution calendar + repo metadata.
# Optional: without it the build falls back to the public contributions API
# and unauthenticated REST (logs a one-line warning).
# Set it on Vercel for Production + Preview; locally put it in .env.local.
GITHUB_TOKEN=
