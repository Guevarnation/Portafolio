# GitHub section (src/lib/github.ts)
# Fine-grained personal access token with "Public repositories (read-only)" and
# no other permissions. Used server-side only, at build time and daily ISR
# revalidation, for the GraphQL contribution calendar + repo metadata.
# Optional: without it the build falls back to the public contributions API
# and unauthenticated REST (logs a one-line warning).
# Set it on Vercel for Production + Preview; locally put it in .env.local.
GITHUB_TOKEN=

# Contact form (src/app/actions/contact.ts, sent with Resend)
# API key from https://resend.com/api-keys. Server-only; without it the form
# shows a "email me directly" fallback and logs a one-line warning.
# Free tier: 3,000 emails/month, 100/day.
RESEND_API_KEY=
# Sender. Resend's onboarding address is for testing only and delivers solely
# to the inbox of the Resend account that owns the key, so that account must
# be registered as guevaraeu1@gmail.com (the hard-coded recipient). For real
# use: verify eugenioguevara.com in Resend, then set
# RESEND_FROM="Portfolio <contact@eugenioguevara.com>" on Vercel
# (Production + Preview) and submit the live form once to confirm receipt.
RESEND_FROM="Portfolio <onboarding@resend.dev>"
#
# Abuse controls (no env needed). In code, in this order: honeypot field
# (`contact_extra`, silent success + server warning), a 13-digit mount
# timestamp that must be 3 s - 24 h old (client-supplied, unsigned: a speed
# bump, not proof of humanity), zod validation, and a per-IP limiter of 5 send
# attempts / 10 min. That limiter is in-memory, so on Vercel it is
# per-instance and not durable. Residual risk: a determined client can still
# burn the Resend daily quota (100/day) and spam the inbox with an
# attacker-chosen reply-to. Durable mitigation, owner action: add a Vercel
# WAF rate-limit rule (Project > Firewall) for POST requests to "/" and "/es"
# (e.g. 5 per 10 min per IP), or swap the in-memory Map for Upstash/Vercel KV.
